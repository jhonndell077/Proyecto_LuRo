{
  "name": "luro-control",
  "version": "1.0.0",
  "description": "LuRo Control - Sistema de Gestión",
  "main": "index.html",
  "scripts": {
    "start": "firebase serve",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./Deploy.ps1 -Target hosting",
    "deploy:analyze": "powershell -NoProfile -ExecutionPolicy Bypass -File ./Deploy.ps1 -Analyze",
    "deploy:functions": "powershell -NoProfile -ExecutionPolicy Bypass -File ./Deploy.ps1 -Target functions",
    "deploy:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./Deploy.ps1 -Target all",
    "Deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./Deploy.ps1 -Target hosting",
    "audit:structure": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-structure.ps1"
  },
  "keywords": [
    "firebase",
    "hosting",
    "luro-control"
  ],
  "author": "jhonndell077",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^29.1.1",
    "pdfjs-dist": "6.5.438"
  },
  "dependencies": {
    "puppeteer": "^25.2.1"
  }
}
