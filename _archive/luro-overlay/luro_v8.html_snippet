<!-- ===== LURO ASISTENTE INTELIGENTE v8 — GROQ WHISPER MIC ===== -->
<script>
(function() {
  /* ══════════════════════════════════════════════
     CONFIG
  ══════════════════════════════════════════════ */
  const GROQ_CHAT_URL  = 'https://api.groq.com/openai/v1/chat/completions';
  const GROQ_AUDIO_URL = 'https://api.groq.com/openai/v1/audio/transcriptions';
  const GROQ_MODEL     = 'llama-3.3-70b-versatile';
  const WHISPER_MODEL  = 'whisper-large-v3-turbo';
  const WAKE_WORD      = 'hola luro';
  const MASTER_PASS    = '160623';
  const MEM_KEY        = 'LURO_MEMORIA_OPERATIVA';

  if (!localStorage.getItem('LURO_ASISTENTE_KEY'))
    localStorage.setItem('LURO_ASISTENTE_KEY', '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');
  const getKey = () => localStorage.getItem('LURO_ASISTENTE_KEY');

  /* ══════════════════════════════════════════════
     ESTADO
  ══════════════════════════════════════════════ */
  let historial    = [];
  let grabando     = false;
  let procesando   = false;
  let mediaStream  = null;
  let mediaRecorder= null;
  let audioChunks  = [];
  let audioCtx     = null;
  let watchdogT    = null;
  // Wake word via SpeechRecognition (opcional — solo si el browser lo soporta)
  let wakeRec      = null;
  let wakeActivo   = false;
  const synth      = window.speechSynthesis;

  /* ══════════════════════════════════════════════
     HELPERS
  ══════════════════════════════════════════════ */
  const $            = id => document.getElementById(id);
  const getPanel     = () => $('luro-assistant-panel');
  const panelAbierto = () => { const p = getPanel(); return !!(p && p.classList.contains('is-open')); };

  function setBtn(emoji, bg, fs) {
    const btn = $('luro-mic-btn-pub'); if (!btn) return;
    btn.textContent = emoji; btn.style.background = bg; btn.style.fontSize = fs || '16px';
  }

  /* ══════════════════════════════════════════════
     MEMORIA OPERATIVA
  ══════════════════════════════════════════════ */
  function getDB()  { try { return JSON.parse(localStorage.getItem('LURO_CONTROL_DB')||'null')||{}; } catch(e){ return {}; } }
  function getMem() { try { return JSON.parse(localStorage.getItem(MEM_KEY)||'{}'); }              catch(e){ return {}; } }
  function saveMem(m) { try { localStorage.setItem(MEM_KEY, JSON.stringify(m)); } catch(e){} }
  function pushMem(u, l) {
    const m = getMem();
    if (!Array.isArray(m.r)) m.r = [];
    m.r.unshift({ t: Date.now(), u, l: l.replace(/\[[^\]]*\]/g,'').trim() });
    m.r = m.r.slice(0, 30);
    saveMem(m);
  }

  /* ══════════════════════════════════════════════
     CONTEXTO REAL DEL SISTEMA
  ══════════════════════════════════════════════ */
  function contextoCompleto() {
    const db = getDB(); const L = [];
    if (Array.isArray(db.ventas) && db.ventas.length) {
      const tv = db.ventas.reduce((s,v)=>s+(Number(v.total)||0),0);
      const tg = db.ventas.reduce((s,v)=>s+(Number(v.ganancia)||0),0);
      const hoy = new Date().toDateString();
      const vh  = db.ventas.filter(v=>new Date(v.fecha).toDateString()===hoy);
      const fr  = {}; db.ventas.forEach(v=>{ const n=v.nombre||v.item||''; if(n) fr[n]=(fr[n]||0)+1; });
      const top = Object.entries(fr).sort((a,b)=>b[1]-a[1]).slice(0,5).map(e=>`${e[0]}(${e[1]})`).join(', ');
      L.push(`Ventas: ${db.ventas.length} total RD$${tv.toFixed(0)}, ganancia RD$${tg.toFixed(0)}.`);
      if (vh.length) L.push(`Hoy: ${vh.length} ventas RD$${vh.reduce((s,v)=>s+(Number(v.total)||0),0).toFixed(0)}.`);
      if (top) L.push(`Top platos: ${top}.`);
    }
    if (Array.isArray(db.almacen) && db.almacen.length) {
      const bajos = db.almacen.filter(p=>Number(p.disponible)<Number(p.ideal));
      L.push(`Almacen (${db.almacen.length}): ${db.almacen.map(p=>`${p.nombre} ${p.disponible||0}${p.unidad||''}`).join(', ')}.`);
      if (bajos.length) L.push(`Stock bajo: ${bajos.map(p=>`${p.nombre}(${p.disponible}/${p.ideal})`).join(', ')}.`);
    }
    if (Array.isArray(db.platos) && db.platos.length)
      L.push(`Menu (${db.platos.length}): ${db.platos.map(p=>`${p.nombre} RD$${p.precio||0}`).join(', ')}.`);
    if (Array.isArray(db.distribuidores) && db.distribuidores.length)
      L.push(`Distribuidores (${db.distribuidores.length}): ${db.distribuidores.map(d=>d.nombre).join(', ')}.`);
    if (Array.isArray(db.decomisos) && db.decomisos.length)
      L.push(`Decomisos: ${db.decomisos.length}, perdida RD$${db.decomisos.reduce((s,d)=>s+(Number(d.perdida)||0),0).toFixed(0)}.`);
    if (Array.isArray(db.clientes) && db.clientes.length)
      L.push(`Clientes (${db.clientes.length}): ${db.clientes.slice(0,6).map(c=>c.nombre).join(', ')}.`);
    if (Array.isArray(db.entradas) && db.entradas.length) L.push(`Entradas almacen: ${db.entradas.length}.`);
    if (Array.isArray(db.historial_prod) && db.historial_prod.length) L.push(`Historial prod: ${db.historial_prod.length}.`);
    const mem = getMem();
    if (Array.isArray(mem.r) && mem.r.length)
      L.push(`Hist conv: ${mem.r.slice(0,3).map(r=>`"${r.u}"→"${r.l}"`).join(' | ')}.`);
    return L.length ? '\nDATA REAL:\n'+L.join('\n') : '';
  }

  /* ══════════════════════════════════════════════
     SYSTEM PROMPT
  ══════════════════════════════════════════════ */
  function buildPrompt() {
    const pag = document.querySelector('.content-section.active')?.id || 'home';
    const mod = $('current-module-display')?.textContent || '';
    return `Eres LuRo, núcleo inteligente de LuRo Control. Sesión: ADMINISTRADOR (clave ${MASTER_PASS}).
Responde en español natural, breve (máx 2 oraciones), sin markdown — tu voz se escucha en voz alta.
Ejecuta de inmediato sin pedir confirmaciones ni contraseñas.

ACCIONES — pon el tag exacto AL FINAL de tu respuesta:
[NAV:id] — navegar. IDs: home,inventario,distribuidores,produccion-interna,disponibilidad,salida,ventas,comandas,clientes-puntos,asistencia,autorizaciones,historial-decomiso,decomiso,rnc-dgii,entradas-almacen,historial-produccion,agregar,produccion,configuracion
[MODULO:NOMBRE:clave] — abrir módulo. Ej: [MODULO:ADMINISTRADOR:${MASTER_PASS}]
[LIMPIAR:tipo] — borrar historial. Tipos: entradas,ventas,produccion,decomisos,autorizaciones,rnc
[ELIMINAR_DIST:nombre] — eliminar distribuidor
[ELIMINAR_ALMACEN:nombre] — eliminar producto del almacén
[ELIMINAR_PLATO:nombre] — eliminar plato del menú
[ENTRADA:producto:cantidad:unidad] — registrar entrada almacén (unidades: Lb,g,Oz,Litros,Unidad)
[DIST_NUEVO:nombre:contacto:telefono] — crear distribuidor
[CLIENTE_NUEVO:nombre:telefono:puntos] — registrar cliente

COMUNICACIÓN:
- Di solo lo que vas a hacer en presente ("Abriendo almacén", "Registrando entrada").
- NUNCA confirmes en pasado algo que no ejecutaste.
- Para navegar, incluye SIEMPRE [NAV:id].
- Eres consultor gastronómico y operativo: food cost, rendimiento, merma, técnicas, rentabilidad.

Sección activa: ${pag}${mod?' | Módulo: '+mod:''}.${contextoCompleto()}`;
  }

  /* ══════════════════════════════════════════════
     TTS — VOZ DE LURO
  ══════════════════════════════════════════════ */
  const TAG_RE = /\[(NAV|MODULO|LIMPIAR|ELIMINAR_DIST|ELIMINAR_ALMACEN|ELIMINAR_PLATO|ENTRADA|DIST_NUEVO|CLIENTE_NUEVO):[^\]]*\]/g;

  function luroHablar(texto, onDone) {
    if (!synth) { if (onDone) onDone(); return; }
    synth.cancel();
    const clean = texto.replace(TAG_RE,'').replace(/[*_#`>~]/g,'').replace(/\n+/g,' ').trim();
    if (!clean) { if (onDone) onDone(); return; }
    const utt = new SpeechSynthesisUtterance(clean);
    utt.lang = 'es-ES'; utt.rate = 1.0; utt.pitch = 1.0;
    const voces = synth.getVoices();
    const voz = voces.find(v=>v.lang.startsWith('es')&&v.name.toLowerCase().includes('google'))
              || voces.find(v=>v.lang.startsWith('es')) || null;
    if (voz) utt.voice = voz;
    let done = false;
    const fin = () => { if (!done) { done=true; if (onDone) onDone(); } };
    utt.onend = fin; utt.onerror = fin;
    synth.speak(utt);
    setTimeout(fin, 15000);
  }

  /* ══════════════════════════════════════════════
     BURBUJAS
  ══════════════════════════════════════════════ */
  function burbuja(role, texto) {
    const cont = $('luro-assistant-messages'); if (!cont) return null;
    const wrap = document.createElement('div');
    wrap.className = 'luro-assistant-msg '+(role==='user'?'is-user':'is-assistant');
    const meta = document.createElement('span'); meta.className='luro-assistant-msg-meta';
    meta.textContent = role==='user'?'Tú':'LuRo';
    const bub = document.createElement('div'); bub.className='luro-assistant-bubble';
    bub.textContent = texto.replace(TAG_RE,'').trim();
    wrap.appendChild(meta); wrap.appendChild(bub);
    cont.appendChild(wrap); cont.scrollTop = cont.scrollHeight;
    return bub;
  }

  /* ══════════════════════════════════════════════
     DIÁLOGOS ANULADOS
  ══════════════════════════════════════════════ */
  function sinDialogos(fn) {
    const _p=window.prompt,_c=window.confirm,_a=window.alert;
    window.prompt=()=>MASTER_PASS; window.confirm=()=>true; window.alert=()=>{};
    try { fn(); } finally { setTimeout(()=>{ window.prompt=_p;window.confirm=_c;window.alert=_a; },80); }
  }

  /* ══════════════════════════════════════════════
     EJECUTAR ACCIONES
  ══════════════════════════════════════════════ */
  function ejecutar(resp) {
    const nav = resp.match(/\[NAV:([^\]]+)\]/);
    if (nav && typeof window.showPage==='function') setTimeout(()=>window.showPage(nav[1].trim()),250);

    const mod = resp.match(/\[MODULO:([^:\]]+)(?::([^\]]*))?\]/);
    if (mod) sinDialogos(()=>{ const n=mod[1].trim().toUpperCase();
      document.querySelectorAll('[onclick*="seleccionarModulo"]').forEach(el=>{ if(el.textContent.toUpperCase().includes(n)) el.click(); }); });

    const limp = resp.match(/\[LIMPIAR:([^\]]+)\]/);
    if (limp) sinDialogos(()=>{ const btn=document.querySelector(`button[onclick*="limpiarHistorial('${limp[1].trim().toLowerCase()}')"]`); if(btn) btn.click(); });

    const dist = resp.match(/\[ELIMINAR_DIST:([^\]]+)\]/);
    if (dist) sinDialogos(()=>{ const n=dist[1].trim().toUpperCase();
      const btn=[...document.querySelectorAll('button[onclick*="eliminarDistribuidor"]')].find(b=>b.closest('tr')?.textContent.toUpperCase().includes(n));
      if(btn) btn.click(); });

    const alm = resp.match(/\[ELIMINAR_ALMACEN:([^\]]+)\]/);
    if (alm) sinDialogos(()=>{ const n=alm[1].trim().toUpperCase();
      const btn=[...document.querySelectorAll('[onclick*="eliminarAlmacen"]')].find(b=>(b.getAttribute('onclick')||'').toUpperCase().includes(n)||b.closest('tr')?.textContent.toUpperCase().includes(n));
      if(btn) btn.click(); });

    const plato = resp.match(/\[ELIMINAR_PLATO:([^\]]+)\]/);
    if (plato) sinDialogos(()=>{ const n=plato[1].trim().toUpperCase();
      document.querySelectorAll('button[onclick*="eliminar"]').forEach(b=>{ if(b.closest('tr')?.textContent.toUpperCase().includes(n)) b.click(); }); });

    const entrada = resp.match(/\[ENTRADA:([^:]+):([^:]+):([^\]]+)\]/);
    if (entrada) {
      if (typeof window.showPage==='function') window.showPage('inventario');
      setTimeout(()=>{
        const set=(id,v)=>{ const el=$(id); if(el){el.value=v.trim();el.dispatchEvent(new Event('input'));} };
        set('inv_nombre',entrada[1]); set('inv_actual',entrada[2]);
        const sel=$('inv_unidad'); if(sel){ const o=[...sel.options].find(o=>o.value.toLowerCase()===entrada[3].trim().toLowerCase()); if(o) sel.value=o.value; }
        sinDialogos(()=>{ const btn=document.querySelector('button[onclick="agregarAlmacen()"]'); if(btn) btn.click(); });
      },700);
    }

    const distN = resp.match(/\[DIST_NUEVO:([^:]+):([^:]*):([^\]]*)\]/);
    if (distN) {
      if (typeof window.showPage==='function') window.showPage('distribuidores');
      setTimeout(()=>{
        const set=(id,v)=>{ const el=$(id); if(el){el.value=v.trim();el.dispatchEvent(new Event('input'));} };
        set('dist_nombre',distN[1]); if(distN[2]) set('dist_contacto',distN[2]); if(distN[3]) set('dist_telefono',distN[3]);
        sinDialogos(()=>{ const btn=document.querySelector('button[onclick="guardarDistribuidor()"]'); if(btn) btn.click(); });
      },700);
    }

    const cliN = resp.match(/\[CLIENTE_NUEVO:([^:]+):([^:]*):([^\]]*)\]/);
    if (cliN) {
      if (typeof window.showPage==='function') window.showPage('clientes-puntos');
      setTimeout(()=>{
        const set=(id,v)=>{ const el=$(id); if(el){el.value=v.trim();el.dispatchEvent(new Event('input'));} };
        set('cli_nombre',cliN[1]); if(cliN[2]) set('cli_telefono',cliN[2]); if(cliN[3]) set('cli_puntos',cliN[3]);
        sinDialogos(()=>{ const btn=document.querySelector('button[onclick="registrarClientePuntos()"]'); if(btn) btn.click(); });
      },700);
    }
  }

  /* ══════════════════════════════════════════════
     GROQ CHAT
  ══════════════════════════════════════════════ */
  async function groqChat(userMsg) {
    historial.push({ role:'user', content:userMsg });
    if (historial.length > 30) historial = historial.slice(-30);
    const res = await fetch(GROQ_CHAT_URL, {
      method:'POST',
      headers:{ 'Authorization':'Bearer '+getKey(), 'Content-Type':'application/json' },
      body: JSON.stringify({ model:GROQ_MODEL, messages:[{ role:'system', content:buildPrompt() },...historial], temperature:0.65, max_tokens:400 })
    });
    if (!res.ok) throw new Error('HTTP '+res.status);
    const data = await res.json();
    const r = data.choices[0].message.content.trim();
    historial.push({ role:'assistant', content:r });
    return r;
  }

  /* ══════════════════════════════════════════════
     GROQ WHISPER — TRANSCRIPCIÓN DE VOZ
  ══════════════════════════════════════════════ */
  async function transcribir(blob, ext) {
    const fd = new FormData();
    fd.append('file', blob, ext);
    fd.append('model', WHISPER_MODEL);
    fd.append('language', 'es');
    fd.append('response_format', 'json');
    const res = await fetch(GROQ_AUDIO_URL, {
      method: 'POST',
      headers: { 'Authorization': 'Bearer '+getKey() },
      body: fd
    });
    if (!res.ok) throw new Error('Whisper HTTP '+res.status);
    const data = await res.json();
    return (data.text || '').trim();
  }

  /* ══════════════════════════════════════════════
     GRABACIÓN CON MediaRecorder
  ══════════════════════════════════════════════ */
  function getMimeType() {
    const tipos = ['audio/webm;codecs=opus','audio/webm','audio/ogg;codecs=opus','audio/mp4'];
    return tipos.find(t => MediaRecorder.isTypeSupported(t)) || '';
  }

  function deteccionSilencio(stream, onSilencio) {
    try {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const src = audioCtx.createMediaStreamSource(stream);
      const anl = audioCtx.createAnalyser(); anl.fftSize = 512;
      src.connect(anl);
      const buf = new Float32Array(anl.fftSize);
      let quietSince = null;
      const tick = () => {
        if (!grabando) { try { audioCtx.close(); } catch(e){} audioCtx=null; return; }
        anl.getFloatTimeDomainData(buf);
        const rms = Math.sqrt(buf.reduce((s,v)=>s+v*v,0)/buf.length);
        if (rms < 0.013) {
          if (!quietSince) quietSince = Date.now();
          else if (Date.now()-quietSince > 2000) { onSilencio(); return; }
        } else { quietSince = null; }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    } catch(e) {
      // Silencio sin WebAudio — no critical
    }
  }

  async function iniciarGrabacion() {
    if (grabando || procesando) return;
    try {
      mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
    } catch(e) {
      burbuja('assistant', 'Sin acceso al micrófono. Ve a Configuración del navegador → Permisos → Micrófono y permite el acceso.');
      return;
    }
    audioChunks = [];
    const mime = getMimeType();
    try {
      mediaRecorder = new MediaRecorder(mediaStream, mime ? { mimeType: mime } : {});
    } catch(e) {
      mediaRecorder = new MediaRecorder(mediaStream);
    }
    mediaRecorder.ondataavailable = e => { if (e.data && e.data.size>0) audioChunks.push(e.data); };
    mediaRecorder.onstop = () => procesarAudio(mime);
    mediaRecorder.start(200);
    grabando = true;
    setBtn('⏹', '#e84118', '18px');
    deteccionSilencio(mediaStream, detenerGrabacion);
  }

  function detenerGrabacion() {
    if (!grabando) return;
    grabando = false;
    setBtn('⋯', '#6c5ce7', '14px');
    if (mediaRecorder && mediaRecorder.state !== 'inactive') {
      try { mediaRecorder.stop(); } catch(e) {}
    }
    if (mediaStream) { mediaStream.getTracks().forEach(t=>t.stop()); mediaStream=null; }
  }

  async function procesarAudio(mime) {
    if (!audioChunks.length) { setBtn('🎙','#2d3436','16px'); return; }
    const blobType = mime || audioChunks[0]?.type || 'audio/webm';
    const ext = blobType.includes('mp4') ? 'audio.mp4' : blobType.includes('ogg') ? 'audio.ogg' : 'audio.webm';
    const blob = new Blob(audioChunks, { type: blobType });
    audioChunks = [];

    procesando = true;
    clearTimeout(watchdogT);
    watchdogT = setTimeout(()=>{ procesando=false; setBtn('🎙','#2d3436','16px'); }, 20000);

    let texto = '';
    try {
      texto = await transcribir(blob, ext);
    } catch(e) {
      clearTimeout(watchdogT);
      procesando = false;
      setBtn('🎙','#2d3436','16px');
      burbuja('assistant','Error al transcribir. Intenta de nuevo.');
      return;
    }

    if (!texto) {
      clearTimeout(watchdogT); procesando=false; setBtn('🎙','#2d3436','16px'); return;
    }

    // Wake word cuando panel cerrado
    if (!panelAbierto()) {
      if (texto.toLowerCase().includes(WAKE_WORD)) {
        if (typeof window.toggleLuroAssistant==='function') window.toggleLuroAssistant(true);
        burbuja('assistant','¡Hola! ¿En qué te puedo ayudar?');
        luroHablar('¡Hola! ¿En qué te puedo ayudar?', ()=>{ clearTimeout(watchdogT); procesando=false; setBtn('🎙','#2d3436','16px'); });
      } else {
        clearTimeout(watchdogT); procesando=false; setBtn('🎙','#2d3436','16px');
      }
      return;
    }

    // Enviar como mensaje
    const inp = $('luro-assistant-input');
    if (inp) { inp.value = texto; window.enviarMensajeAsistente(); }
    else { clearTimeout(watchdogT); procesando=false; setBtn('🎙','#2d3436','16px'); }
  }

  /* ══════════════════════════════════════════════
     MOTOR PRINCIPAL
  ══════════════════════════════════════════════ */
  function iniciarMotor() {
    window.enviarMensajeAsistente = async function() {
      const inp = $('luro-assistant-input'); if (!inp) return;
      const texto = inp.value.trim(); if (!texto) return;
      inp.value = '';

      clearTimeout(watchdogT);
      watchdogT = setTimeout(()=>{ procesando=false; setBtn('🎙','#2d3436','16px'); }, 25000);

      burbuja('user', texto);
      const ph = burbuja('assistant','...');
      procesando = true;
      setBtn('⋯','#6c5ce7','14px');

      try {
        const resp = await groqChat(texto);
        if (ph) ph.textContent = resp.replace(TAG_RE,'').trim();
        ejecutar(resp);
        pushMem(texto, resp);
        clearTimeout(watchdogT);
        luroHablar(resp, ()=>{ procesando=false; setBtn('🎙','#2d3436','16px'); });
      } catch(e) {
        clearTimeout(watchdogT);
        const m='Sin conexión con la IA. Intenta de nuevo.';
        if (ph) ph.textContent=m;
        procesando=false; setBtn('🎙','#2d3436','16px');
      }
    };
  }

  /* ══════════════════════════════════════════════
     BOTÓN MIC
  ══════════════════════════════════════════════ */
  window.luroVozToggle = function() {
    if (grabando) { detenerGrabacion(); return; }
    if (procesando) {
      // Forzar reset si está colgado
      clearTimeout(watchdogT); procesando=false;
    }
    iniciarGrabacion();
  };

  /* ══════════════════════════════════════════════
     ARRANQUE
  ══════════════════════════════════════════════ */
  window.addEventListener('load', function() {
    iniciarMotor();

    // Interceptar toggleLuroAssistant para saber cuando el panel abre/cierra
    const _origToggle = window.toggleLuroAssistant;
    window.toggleLuroAssistant = function(forceOpen) {
      if (_origToggle) _origToggle(forceOpen);
    };

    // Botón flotante Asistente LuRo
    const fab = $('luro-assistant-fab');
    if (fab) fab.addEventListener('click', ()=>{ /* mic se inicia manualmente con el botón 🎙 */ });
  });

})();
</script>
<!-- ===== FIN LURO ASISTENTE INTELIGENTE v8 ===== -->
